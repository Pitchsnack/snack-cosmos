# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Environment files (FENV-B). `*.local` above already covers `.env.local`; this rule covers the
# bare `.env`, which it does NOT match. `.env` was tracked in this repository and carried live
# Supabase configuration, and a tracked env file is a standing invitation to commit a value. The
# tracked names-only template is `.env.example`.
.env
.env.*
!.env.example

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
